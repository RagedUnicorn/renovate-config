{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for the RagedUnicorn docker-* image repositories. ignorePaths intentionally overrides the :ignoreModulesAndTests preset from config:recommended: test/ must stay visible so the metadata-test custom manager can update test/<tool>_metadata_test.yml",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Zurich",
  "schedule": [
    "on monday"
  ],
  "labels": [
    "dependencies",
    "renovate"
  ],
  "ignorePaths": [
    "docker-compose.yml",
    "docker-compose.*.yml",
    "examples/**"
  ],
  "packageRules": [
    {
      "description": "Group every Alpine reference (FROM, base.name label, metadata test) into one PR",
      "matchPackageNames": [
        "alpine"
      ],
      "groupName": "alpine",
      "groupSlug": "alpine"
    },
    {
      "description": "Automatically merge minor and patch updates for Alpine once they have been out for a few days",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "alpine"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update versions pinned via renovate comments before ARG lines in the Dockerfile",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)(?: versioning=(?<versioning>.*?))?\\s+ARG .*?=(?<currentValue>.*)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Keep the container-structure-test harness pin in .env up to date",
      "managerFilePatterns": [
        "/^\\.env$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+CONTAINER_STRUCTURE_TEST_VERSION=(?<currentValue>.*)"
      ],
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-alpine[\\d.]+-(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Keep the Alpine base.name OCI label in the Dockerfile in sync with the FROM version",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "alpine",
      "versioningTemplate": "docker",
      "matchStrings": [
        "image\\.base\\.name=\"docker\\.io/library/alpine:(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Keep the Alpine version in the metadata test in sync with the FROM version",
      "managerFilePatterns": [
        "/^test/.+_metadata_test\\.yml$/"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "alpine",
      "versioningTemplate": "docker",
      "matchStrings": [
        "docker\\.io/library/alpine:(?<currentValue>[^']+)'"
      ]
    }
  ]
}
